# Resolved through node rather than a relative path: `react-native` is hoisted to
# the workspace root, so the template's `../node_modules/react-native` does not
# exist from here. Same reason `android/settings.gradle` resolves the RN Gradle
# plugin with `require.resolve`.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Hardcoded, NOT `min_ios_version_supported` — that is 15.1, below jojo's floor.
# The floor is stated in three places (here, IPHONEOS_DEPLOYMENT_TARGET in the
# pbxproj, and the README) and this is the one CocoaPods reads.
platform :ios, '16.4'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'jojo' do
  # No argument: this runs `npx react-native config`. The Expo Podfile passed an
  # explicit `expo-modules-autolinking react-native-config` command here, which
  # impersonated that output. Verified against the real thing — all eleven native
  # modules report an iOS podspec, and `project.ios.sourceDir` and
  # `reactNativePath` both resolve correctly under workspace hoisting unaided.
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
  end
end
