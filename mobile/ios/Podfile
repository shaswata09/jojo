# Resolved through node rather than a relative path: `react-native` is hoisted to
# the workspace root, so the template's `../node_modules/react-native` does not
# exist from here. Same reason `android/settings.gradle` resolves the RN Gradle
# plugin with `require.resolve`.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Hardcoded, NOT `min_ios_version_supported` — that is 15.1, below jojo's floor.
# This is the one CocoaPods reads. The pbxproj states it four more times —
# `IPHONEOS_DEPLOYMENT_TARGET` on the jojo target's two configurations and on the
# PROJECT's two, which Xcode's inspector shows and a new target inherits. Those
# last two read 15.1 until this was audited: the app still built at 16.4 because
# the single target overrode them, so a second target would have dropped under
# the floor with nothing to say so. Nothing checks any of the five.
platform :ios, '16.4'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# ---------------------------------------------------------------------------
# Firebase resolves through CocoaPods, NOT Swift Package Manager.
#
# react-native-firebase 26 defaults to pulling firebase-ios-sdk over SPM, and
# that combination does not work here — `pod install` refuses it outright:
#
#   [!] [react-native-firebase] SPM + static linkage is not supported.
#
# firebase-ios-sdk's SPM products are automatic libraries rather than
# `type: .dynamic`, so each of the three RNFB pods embeds its own copy of
# Firebase and they collide at link time as duplicate symbols. This project
# links statically — `use_frameworks!` above is opt-in through USE_FRAMEWORKS
# and unset by default, which is the React Native 0.81 default and what the New
# Architecture build expects.
#
# The alternative the error offers is `use_frameworks! :linkage => :dynamic`,
# which would change how EVERY pod in this project links in order to
# accommodate one of them. This line changes one.
#
# The Firebase console suggests adding the SDK through Xcode's own package
# manager (File ▸ Add Packages). Do not: RNFB's pods would still bring their own
# Firebase, and two copies is the same duplicate-symbol failure arrived at from
# a direction `pod install` cannot warn about.
$RNFirebaseDisableSPM = true

target 'jojo' do
  # Module maps for the three C pods Firebase's Swift code imports.
  #
  # `pod install` refuses the install without these:
  #
  #   The Swift pod `FirebaseCrashlytics` depends upon `GoogleDataTransport`,
  #   `GoogleUtilities`, and `nanopb`, which do not define modules.
  #
  # A Swift target cannot `import` a static Objective-C library that ships no
  # module map, and these three ship none. CocoaPods will generate one per pod
  # on request, which is what this is.
  #
  # NAMED INDIVIDUALLY rather than `use_modular_headers!` at the top of the
  # file. The global switch turns modular headers on for every pod in the
  # project, React Native's twenty-odd included, and several of those rely on
  # non-modular header imports that then stop compiling. Three lines here
  # change three pods.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  # No argument: this runs `npx react-native config`. The Expo Podfile passed an
  # explicit `expo-modules-autolinking react-native-config` command here, which
  # impersonated that output. Verified against the real thing — all eleven native
  # modules report an iOS podspec, and `project.ios.sourceDir` and
  # `reactNativePath` both resolve correctly under workspace hoisting unaided.
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # fmt 11.0.2, which React Native 0.81 vendors, does not compile under
    # Xcode 26's clang, and the failure is entirely inside fmt's own headers —
    # five `call to consteval function ... is not a constant expression` errors
    # in `format-inl.h`, none reachable from this app's code.
    #
    # clang 17+ enforces that a consteval call must itself be a constant
    # expression; fmt's `FMT_STRING(...)` uses in that file are not. fmt gates
    # this on `FMT_USE_CONSTEVAL`, but 11.0.2 defines that macro through an
    # unguarded `#if/#elif` chain with no `#ifndef` — so a `-D` on the command
    # line is redefined by the header and loses. That was tried first and the
    # build failed identically, which is how the chain was found.
    #
    # So the header is patched instead: the `__cpp_consteval` branch is forced
    # to 0. Scoped to fmt, applied on every `pod install` (the Pods tree is not
    # committed), and idempotent. Delete it when React Native ships a newer fmt.
    fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      src = File.read(fmt_base)
      # Patch the single CONSUMER of the macro rather than the branches that
      # set it — the chain has two `= 1` arms and disabling one just falls
      # through to the other, which is what the first attempt did.
      marker = "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval"
      patched = "#if 0  // jojo: FMT_USE_CONSTEVAL forced off, Xcode 26 clang, see Podfile\n#  define FMT_CONSTEVAL consteval"
      unless src.include?(patched)
        # CocoaPods installs pod sources read-only, so this has to widen the
        # mode first and put it back afterwards.
        mode = File.stat(fmt_base).mode
        File.chmod(0o644, fmt_base)
        File.write(fmt_base, src.sub(marker, patched))
        File.chmod(mode & 0o7777, fmt_base)
        Pod::UI.puts '[jojo] patched fmt/base.h to disable consteval'
      end
    end
  end
end
