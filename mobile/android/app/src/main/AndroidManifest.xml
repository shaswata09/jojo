<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET"/>
  <!--
    Reading the pairing code off the other device's screen. Requested at the
    moment the transfer screen asks for it, never at launch — and the app works
    without it, minus that one feature.

    `uses-feature required="false"` is what keeps the app installable on a device
    with no camera at all: declaring CAMERA implies the feature, and an implied
    feature is REQUIRED by default, which would quietly remove jojo from the Play
    listing for every camera-less device.
  -->
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
  <!--
    react-native-blob-util's own manifest declares seven permissions, for a
    download manager this app never calls. The merger adds them silently and
    they surface on a Play listing, so the four the app has no use for are
    removed by name. Measured against the pre-ejection APK: without these four
    lines `aapt dump badging` goes from six permissions to ten.

    The other three it declares — INTERNET, READ_EXTERNAL_STORAGE,
    WRITE_EXTERNAL_STORAGE — are already ours, above.

    That day came. ACCESS_NETWORK_STATE and ACCESS_WIFI_STATE used to be removed
    here too, for the same reason as the two below — blob-util declares them and
    jojo did not want them. Transfer wants them now: @react-native-community/netinfo
    reads this device's own wifi address so the other device knows where to
    connect, and neither the removal nor its consequence produces a build
    warning. The symptom would have been `details.ipAddress` returning null on a
    phone that is plainly on wifi.

    They are declared positively below rather than merely un-removed, so the
    reason travels with the line. Re-check the merged result with
    `aapt dump badging` after touching any of this.
  -->
  <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove"/>
  <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" tools:node="remove"/>
  <!--
    Wanted, for exactly one screen. Transfer needs to tell the other device this
    phone's address on the local network; both are needed for
    `NetInfo.fetch().details.ipAddress` to be populated across the Android
    versions jojo supports. Neither grants access to the internet beyond the
    INTERNET permission already declared, and neither is a runtime prompt.
  -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="unspecified">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="jojo"/>
      </intent-filter><intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="text/plain"/></intent-filter>
    </activity>
  </application>
</manifest>
