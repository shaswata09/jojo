{
  "manifest_version": 3,
  "name": "jojo — keep this posting",
  "version": "0.1.0",
  "description": "Saves a job posting exactly as it reads today, into your own jojo vault. Nothing is uploaded anywhere.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Keep this posting in jojo"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "capture@jojo.app",
      "strict_min_version": "121.0"
    }
  }
}
