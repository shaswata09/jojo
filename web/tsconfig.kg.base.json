{
  /*
   * Shared settings for the three src/kg projects. Never built on its own — it
   * has no `include` of its own and the root solution does not reference it.
   *
   * The split exists because one project could not express the rule. `src/kg` is
   * three different environments wearing one folder: core, repo, tools and react
   * must compile on React Native and inside Electron's main process, and storage
   * is the adapter that is allowed to know it is in a browser. A single `lib`
   * setting has to be the union of those, and a union is the permissive one — so
   * `tsconfig.kg.json` extended `tsconfig.app.json`, inherited `"lib": ["ES2023",
   * "DOM"]`, and `document.querySelector` inside `core/validate.ts` compiled
   * clean. The layer rule was enforced by a lint script matching module
   * specifiers, and a global is not an import.
   *
   * Everything that differs between the three is `lib`, `types` and `include`.
   * Everything below is the same for all of them and lives here once.
   */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    /*
     * Three flags the rest of the app does not carry, over src/kg only.
     *
     * `noUncheckedIndexedAccess` app-wide is 94 errors, 47 of them inside
     * components/graph/force.ts — a hot physics loop where every array read is
     * provably in range and the flag is pure noise. In the KG layer the same
     * flag is the difference between `nodes[i]` being a node and being a
     * `TypeError: cannot read property 'type' of undefined` on a store one
     * record shorter than the code assumed.
     *
     * `exactOptionalPropertyTypes` prevents a bug that only appears after
     * Wave 2: a `Partial<T>` patch carrying an explicit `undefined` used to be
     * indistinguishable from an absent key in memory, but IndexedDB's
     * structured clone preserves it — so the key comes back present-and-
     * undefined and every `in` check that guarded a field starts answering the
     * opposite way on the second launch.
     */
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true
  }
}
