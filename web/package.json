{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "npm run pack-extension && npm run make-pwa-icons && tsc -b && vite build && node scripts/spa-fallback.mjs && npm run make-sw",
    "dev": "npm run pack-extension && vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm -w @jojo/service run lint && oxlint",
    "make-extension-icons": "node scripts/make-extension-icons.mjs",
    "make-pwa-icons": "node scripts/make-pwa-icons.mjs",
    "make-sw": "node scripts/make-sw.mjs",
    "pack-extension": "npm run make-extension-icons && node scripts/pack-extension.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@jojo/service": "*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "idb": "8.0.3",
    "lucide-react": "^1.29.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
