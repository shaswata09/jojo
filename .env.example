# jojo — build-time configuration, as a TEMPLATE.
#
# Copy this to `.env` and fill it in; `.env` is gitignored and this file is not.
# Everything is optional: with none of it set, the app builds and runs and
# reports nothing at all.
#
# Vite reads this file from the repo root because web/vite.config.ts sets
# `envDir` to it. Every name must start with VITE_ or Vite refuses to expose it
# to the browser bundle — that prefix is the mechanism that stops a stray secret
# in this file reaching the client.
#
# ---------------------------------------------------------------------------
# Crash reports and usage analytics
# ---------------------------------------------------------------------------
# Two dials each, and this is the BUILD one: it decides what a copy of jojo is
# capable of, and it can only ever take away. The user's own switches live in
# Settings and in the setup flow. See service/kg/core/crash-config.ts.
VITE_CRASH_REPORTING=true
VITE_ANALYTICS=true

# ---------------------------------------------------------------------------
# Firebase, for the web app
# ---------------------------------------------------------------------------
# From the Firebase console: Project settings → General → Your apps → Web.
#
# These are NOT secrets. Google documents them as public: every one of them
# ships inside the JavaScript bundle of any Firebase web app, and `apiKey`
# identifies a project rather than authorising anything. They are kept out of
# git so a FORK's deploy does not report its traffic into this project's
# console — the same reason google-services.json is gitignored.
VITE_FIREBASE_API_KEY=AIza…
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# The measurement id. WITHOUT THIS, Firebase initialises and reports nothing —
# which looks exactly like analytics working and nobody using the app.
VITE_ANALYTICS_ID=G-XXXXXXXXXX
